# Copy to .env and adjust. All app settings use the VDB_ prefix and are
# defined in src/volunteerdb/config.py; the full reference with rationale is
# docs/reference/configuration.md.
#
# Convention in this file: uncommented lines are ones you normally set in
# development. Commented lines show the setting's REAL DEFAULT, so you can
# uncomment and edit in place — tests/test_config_surface.py asserts that
# every commented value here matches the default in config.py, which is how
# this file is kept from drifting. Example (non-default) values live in the
# prose comment above each setting, never in the assignment.

# --- database ---------------------------------------------------------------

# Postgres superuser password for the db container. Consumed by compose, not
# by the app. Must really be set before the db container first starts — see
# the interpolation warning in docs/reference/configuration.md.
POSTGRES_PASSWORD=volunteerdb

# SQLAlchemy async URL the app uses to reach Postgres.
VDB_DATABASE_URL=postgresql+asyncpg://volunteerdb:volunteerdb@localhost:5432/volunteerdb

# --- web server -------------------------------------------------------------

VDB_HOST=0.0.0.0
VDB_PORT=8080

# Uvicorn auto-reload. `make dev` sets this on the command line; it also
# forces the in-app scheduler off, since a reload restart would re-fire it.
#VDB_RELOAD=false

# Uvicorn's trusted-proxy list (no VDB_ prefix — this one is uvicorn's own).
# Behind a TLS-terminating reverse proxy the proxy's X-Forwarded-Proto is only
# honored from a listed address; production sets `*` because the container
# port is published on the host loopback only. Example: FORWARDED_ALLOW_IPS=*
#FORWARDED_ALLOW_IPS=127.0.0.1

# --- sessions ---------------------------------------------------------------

# Secret for signing browser session storage — set a long random string in
# production. Empty: a random per-boot secret is used (sessions reset on
# restart). `make seed` generates one into .env if the file is missing.
VDB_STORAGE_SECRET=

# Set true when served over HTTPS (production): adds Secure to the session cookie.
VDB_COOKIE_SECURE=false

# --- logging ----------------------------------------------------------------

# DEBUG | INFO | AUDIT | WARNING | ERROR. AUDIT logs every database write with
# actor identity plus auth events; INFO adds reads and one line per request.
#VDB_LOG_LEVEL=AUDIT

# Path of an additional rotating log file (10 MB x 6). Empty: stderr only,
# which journald captures in production. In the container this must point into
# a writable volume. Example: VDB_LOG_FILE=/app/.nicegui/volunteerdb.log
#VDB_LOG_FILE=

# --- locale -----------------------------------------------------------------

# IANA zone the parish lives in. Date-typed values (election deadlines, event
# reminder windows) mean "through the end of that day HERE", not in the
# container's UTC clock.
#VDB_TIMEZONE=America/Toronto

# --- identity ---------------------------------------------------------------

# The organisation this instance serves. Appears in outbound mail ("Your
# VolunteerDB account at ..."), and its name and mail domain are added to the
# password policy's context-specific blocklist. Blank: mail drops the clause
# rather than naming a placeholder. Example: VDB_ORG_NAME=St. Peter's
#VDB_ORG_NAME=

# --- email ------------------------------------------------------------------

# SMTP2GO API key for outbound email (invite links, one-time sign-in codes).
# Leave blank in dev: emails are printed to the app log instead of sent, which
# is how you read the OTP code to complete a passwordless login.
VDB_SMTP2GO_API_KEY=

# Sender identity. The address must be on a domain your mail provider is
# authorized to send for, or delivery simply fails — the default is a
# reserved domain precisely so an unset one is obvious rather than quiet.
# Example: VDB_MAIL_FROM=no-reply@example.org
#VDB_MAIL_FROM=no-reply@example.invalid
#VDB_MAIL_FROM_NAME=VolunteerDB

# How long an invite link — which is also the password-reset link — stays
# usable, in hours. 168 = 7 days, a deliberate deviation from the 24-hour
# ceiling NIST SP 800-63B puts on an emailed recovery code; see
# docs/explanation/auth.md.
#VDB_INVITE_TTL_HOURS=168

# --- nightly jobs -----------------------------------------------------------

# In-app scheduler for the nightly jobs (fetch_pages, proposal_digest,
# event_reminders). Always off under VDB_RELOAD=true.
#VDB_SCHEDULER_ENABLED=true

# Where scheduler job failures are emailed; blank: they only log at ERROR.
# Example: VDB_ALERT_EMAIL=admin@example.org
#VDB_ALERT_EMAIL=

# Parish-local (VDB_TIMEZONE) times the jobs run, kept clear of 02:00-02:30
# when the host's backup and Drive-sync timers fire. To watch one fire in dev,
# set it a couple of minutes ahead and start the server without reload.
#VDB_FETCH_PAGES_AT=03:00
#VDB_PROPOSAL_DIGEST_AT=03:30
#VDB_EVENT_REMINDERS_AT=04:00

# Absolute origin used for links in nightly-job emails, which have no live
# request to derive one from. Blank: those emails omit the link. Mail sent
# from the GUI derives links from the request either way.
# Example: VDB_PUBLIC_BASE_URL=https://vdb.example.org
#VDB_PUBLIC_BASE_URL=

# --- integrations -----------------------------------------------------------

# URL of the decorated roster-template Google Sheet. Set: the /import page
# links there instead of offering a bare CSV download.
#VDB_TEMPLATE_SHEET_URL=

# Google Calendar sync: OAuth client + refresh token authorised as the parish
# Google account, and the id of the public calendar it owns. All four set:
# upcoming events are pushed onto that calendar every 30 minutes and /events
# embeds it. Any blank: the sync stays off and nothing embeds. Provisioning:
# docs/how-to/google-calendar-sync.md.
#VDB_GCAL_CLIENT_ID=
#VDB_GCAL_CLIENT_SECRET=
#VDB_GCAL_REFRESH_TOKEN=
#VDB_GCAL_CALENDAR_ID=

# --- documentation ----------------------------------------------------------

# Built HTML manual served at /manual to signed-in users. Relative paths
# resolve against the working directory; the container bakes the manual in and
# overrides this to /app/docs-html.
#VDB_DOCS_DIR=docs/_build/html
