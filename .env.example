# Copy to .env and adjust. All app settings use the VDB_ prefix.

# Postgres superuser password for the db container (compose interpolation)
POSTGRES_PASSWORD=volunteerdb

# SQLAlchemy async URL the app uses to reach Postgres
VDB_DATABASE_URL=postgresql+asyncpg://volunteerdb:volunteerdb@localhost:5432/volunteerdb

# Secret for signing browser session storage — set a long random string in
# production. Empty: a random per-boot secret is used (sessions reset on restart).
VDB_STORAGE_SECRET=

VDB_HOST=0.0.0.0
VDB_PORT=8080

# Set true when served over HTTPS (production): adds Secure to the session cookie.
VDB_COOKIE_SECURE=false

# SMTP2GO API key for outbound email (invite links, one-time sign-in codes).
# Leave blank in dev: emails are printed to the app log instead of sent.
VDB_SMTP2GO_API_KEY=
# Sender identity (defaults shown)
#VDB_MAIL_FROM=no-reply@sttimothyto.org
#VDB_MAIL_FROM_NAME=VolunteerDB
# Lifetime of an invite / password-reset link, in hours (default 24).
#VDB_INVITE_TTL_HOURS=24
