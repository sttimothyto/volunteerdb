[Unit]
Description=VolunteerDB PostgreSQL

[Container]
Image={{ pg_image }}
ContainerName={{ db_container }}
Network={{ net }}.network
# conservative tuning for a >=4 GB host shared with the app container;
# keep in sync with compose.yaml
Exec={{ pg_tuning }}
EnvironmentFile={{ db_env_file }}
Volume=volunteerdb-pgdata:/var/lib/postgresql/data
# No PublishPort: reachable only on the {{ net }} network (DNS: {{ db_container }}).
HealthCmd=pg_isready -U {{ db_user }} -d {{ db_name }}
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=15s
# systemd start blocks until the healthcheck passes, so After= on this unit
# means "DB accepting connections" and the deploy needs no wait loop.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
