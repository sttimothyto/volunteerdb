# Managed by volunteerdb deploy/deploy.py - do not edit by hand.
VDB_DATABASE_URL={{ database_url }}
VDB_STORAGE_SECRET={{ storage_secret }}
# Empty key: outbound email (invites, sign-in codes) is logged, not sent.
VDB_SMTP2GO_API_KEY={{ smtp2go_api_key }}
# Read back by deploy.py to keep the postgres role in sync; ignored by the app.
VDB_DB_PASSWORD={{ db_password }}
VDB_HOST=0.0.0.0
VDB_PORT={{ port }}
VDB_RELOAD=false
# Caddy terminates TLS: mark the session cookie Secure.
VDB_COOKIE_SECURE=true
# Caddy is the only client that can reach the published loopback port; trust
# its X-Forwarded-* headers so request.base_url (invite/login links) is https.
FORWARDED_ALLOW_IPS=*
# AUDIT: every DB write + auth event with actor identity; INFO adds reads
# and per-request lines. View with: journalctl -u volunteerdb-app
VDB_LOG_LEVEL=AUDIT
# Decorated roster-template Google Sheet (see docs/how-to/drive-roster-sync.md).
# Empty: the /import page offers a bare CSV download instead.
VDB_TEMPLATE_SHEET_URL={{ template_sheet_url }}
# Google Calendar sync (docs/how-to/google-calendar-sync.md): OAuth client +
# refresh token authorised as the parish account, and the public calendar's
# id. Read back by deploy.py like the sheet URL — set once, reused after.
# Any empty: the 30-minute sync stays off and /events shows no embed.
VDB_GCAL_CLIENT_ID={{ gcal_client_id }}
VDB_GCAL_CLIENT_SECRET={{ gcal_client_secret }}
VDB_GCAL_REFRESH_TOKEN={{ gcal_refresh_token }}
VDB_GCAL_CALENDAR_ID={{ gcal_calendar_id }}
# Absolute origin for links in nightly-job emails (event reminders); read
# back by deploy.py like the sheet URL. Empty: those emails omit the link.
VDB_PUBLIC_BASE_URL={{ public_base_url }}
# The parish this instance serves. Appears in outbound mail, and its name and
# mail domain are added to the password policy's context-specific blocklist.
VDB_ORG_NAME={{ org_name }}
# Sender identity. The address must be on a domain the mail provider is
# authorised to send for, or delivery simply fails.
VDB_MAIL_FROM={{ mail_from }}
VDB_MAIL_FROM_NAME={{ mail_from_name }}
# Parish-local time zone. Date-typed values (election deadlines, event
# reminder windows) mean "through the end of that day HERE", not in the
# container's UTC clock. The host's backup and Drive-sync timers use the same
# zone, from the same key in the site file.
VDB_TIMEZONE={{ timezone }}
# In-app scheduler runs the nightly jobs (fetch_pages, proposal_digest,
# event_reminders) at the parish-local times below.
VDB_SCHEDULER_ENABLED=true
VDB_FETCH_PAGES_AT={{ fetch_pages_at }}
VDB_PROPOSAL_DIGEST_AT={{ proposal_digest_at }}
VDB_EVENT_REMINDERS_AT={{ event_reminders_at }}
# Scheduler job failures are emailed here (same address the backup and
# drive-sync wrappers alert); empty disables the email.
VDB_ALERT_EMAIL={{ alert_email }}
