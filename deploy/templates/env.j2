# Managed by volunteerdb deploy/deploy.py - do not edit by hand.
VDB_DATABASE_URL={{ database_url }}
VDB_STORAGE_SECRET={{ storage_secret }}
# Empty key: outbound email (invites, sign-in codes) is logged, not sent.
VDB_SMTP2GO_API_KEY={{ smtp2go_api_key }}
# Read back by deploy.py to keep the postgres role in sync; ignored by the app.
VDB_DB_PASSWORD={{ db_password }}
VDB_HOST=0.0.0.0
VDB_PORT={{ port }}
VDB_RELOAD=false
# Caddy terminates TLS: mark the session cookie Secure.
VDB_COOKIE_SECURE=true
# Caddy is the only client that can reach the published loopback port; trust
# its X-Forwarded-* headers so request.base_url (invite/login links) is https.
FORWARDED_ALLOW_IPS=*
# AUDIT: every DB write + auth event with actor identity; INFO adds reads
# and per-request lines. View with: journalctl -u volunteerdb-app
VDB_LOG_LEVEL=AUDIT
# Decorated roster-template Google Sheet (see docs/how-to/drive-roster-sync.md).
# Empty: the /import page offers a bare CSV download instead.
VDB_TEMPLATE_SHEET_URL={{ template_sheet_url }}
# Absolute origin for links in cron-job emails (event reminders); read back
# by deploy.py like the sheet URL. Empty: those emails omit the link.
VDB_PUBLIC_BASE_URL={{ public_base_url }}
