#!/bin/bash
# Managed by volunteerdb deploy/deploy.py - do not edit by hand.
# Nightly (03:30): email each proposal voter one digest of what needs their
# input (added to a roll / voting opened), via a one-shot app container.
# Per-person send failures are handled inside the job (notification stamps
# stay NULL and retry the next night); this wrapper alerts only when the job
# itself dies.
set -Eeuo pipefail

IMAGE='{{ image }}'
NET='{{ net }}'
ENV_FILE='{{ env_file }}'

ERR_CTX="(startup)"
trap 'ERR_CTX="line $LINENO: $BASH_COMMAND"' ERR

{% if alert_email %}
send_alert() {
    local key msg
    msg="volunteerdb proposal digest FAILED on $(hostname) at $(date -Is) - $ERR_CTX. Details: journalctl -t volunteerdb-proposal-digest"
    key=$(sed -n 's/^VDB_SMTP2GO_API_KEY=//p' '{{ env_file }}')
    [ -n "$key" ] || { echo "no VDB_SMTP2GO_API_KEY in {{ env_file }} - cannot send alert" >&2; return 0; }
    curl -sSf --max-time 30 -X POST https://api.smtp2go.com/v3/email/send \
        -H 'Content-Type: application/json' \
        -H "X-Smtp2go-Api-Key: $key" \
        -d "{\"sender\":\"{{ mail_from_name }} <{{ mail_from }}>\",\"to\":[\"{{ alert_email }}\"],\"subject\":\"[volunteerdb] nightly proposal digest FAILED\",\"text_body\":\"$msg\"}" \
        >/dev/null || echo "alert email failed" >&2
}
{% endif %}

cleanup() {
    local status=$?
    if [ "$status" -ne 0 ]; then
        echo "proposal digest FAILED ($ERR_CTX)" >&2
        {% if alert_email %}send_alert{% endif %}
    fi
}
trap cleanup EXIT

podman run --rm --network "$NET" --env-file "$ENV_FILE" "$IMAGE" \
    python -m volunteerdb.jobs.proposal_digest
