# Payload of volunteerdb-backup.timer; `systemctl start volunteerdb-backup`
# is the manual trigger (no [Install] — never runs on its own).
[Unit]
Description=VolunteerDB nightly database backup (pg_dump -> rclone crypt -> Drive)
Wants=network-online.target
After=network-online.target {{ db_container }}.service

[Service]
Type=oneshot
ExecStart={{ backup_script }}
