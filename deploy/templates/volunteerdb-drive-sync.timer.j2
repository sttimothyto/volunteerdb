[Unit]
Description=Nightly VolunteerDB Drive roster sync at {{ drive_sync_at }} parish time

[Timer]
# tz-suffixed OnCalendar needs systemd >= 235; deploy.py asserts support.
OnCalendar=*-*-* {{ drive_sync_at }}:00 {{ timezone }}
# A daytime catch-up sync after host downtime is equivalent to a normal run
# (the sync's ModTime marks make re-runs no-ops on unchanged sheets).
Persistent=true

[Install]
WantedBy=timers.target
