[Unit]
Description=VolunteerDB (NiceGUI)
# Quadlet does not translate names here - reference the GENERATED units:
Requires={{ db_container }}.service
After={{ db_container }}.service

[Container]
Image={{ image }}
ContainerName=volunteerdb-app
Network={{ net }}.network
EnvironmentFile={{ env_file }}
PublishPort=127.0.0.1:{{ listen_port }}:{{ app_port }}
# NiceGUI session storage - the app's only persistent disk state.
Volume=volunteerdb-nicegui:/app/.nicegui
NoNewPrivileges=true
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
