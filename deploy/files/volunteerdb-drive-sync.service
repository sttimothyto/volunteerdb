# Payload of volunteerdb-drive-sync.timer; `systemctl start
# volunteerdb-drive-sync` is the manual trigger (no [Install]).
[Unit]
Description=VolunteerDB nightly Drive roster sync (rclone + import/export legs)
Wants=network-online.target
# After= (not Requires=, cron parity: the sync still runs if the backup
# failed) matters only when a Persistent catch-up queues both start-jobs at
# boot — a oneshot stays "activating" for its whole script, so the sync then
# waits for the dump to finish, preserving the restore-point-before-bulk-write
# ordering. On a normal night the 02:00/02:30 gap orders them, as under cron.
After=network-online.target volunteerdb-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/volunteerdb-drive-sync
