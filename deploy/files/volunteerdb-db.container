[Unit]
Description=VolunteerDB PostgreSQL

[Container]
Image=docker.io/library/postgres:17
ContainerName=volunteerdb-db
Network=volunteerdb.network
# conservative tuning for a >=4 GB host shared with the app container;
# keep in sync with compose.yaml
Exec=postgres -c shared_buffers=512MB -c effective_cache_size=2GB -c work_mem=16MB -c maintenance_work_mem=128MB -c random_page_cost=1.1
EnvironmentFile=/etc/volunteerdb/db.env
Volume=volunteerdb-pgdata:/var/lib/postgresql/data
# No PublishPort: reachable only on the volunteerdb network (DNS: volunteerdb-db).
HealthCmd=pg_isready -U volunteerdb -d volunteerdb
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=15s
# systemd start blocks until the healthcheck passes, so After= on this unit
# means "DB accepting connections" and the deploy needs no wait loop.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
